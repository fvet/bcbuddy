{
  "app": "bc-buddy",
  "version": 2,
  "name": "BC Buddy samples",
  "exportedAt": "2026-10-18T00:00:00.000Z",
  "styles": [
    {
      "id": "full",
      "name": "Full",
      "border": {
        "enabled": true,
        "width": 3
      },
      "banner": {
        "enabled": true,
        "position": "bottom-left",
        "text": "{name}",
        "fontSize": 0,
        "opacity": 0.5
      },
      "ribbon": {
        "enabled": true,
        "text": "Dynamics 365 Business Central - {company} ({environment})"
      },
      "title": {
        "enabled": true,
        "text": "[{name}] {title}"
      },
      "favicon": {
        "enabled": true,
        "text": ""
      }
    },
    {
      "id": "subtle",
      "name": "Subtle",
      "border": {
        "enabled": false,
        "width": 3
      },
      "banner": {
        "enabled": false,
        "position": "bottom-left",
        "text": "{name}",
        "fontSize": 0,
        "opacity": 0.5
      },
      "ribbon": {
        "enabled": true,
        "text": ""
      },
      "title": {
        "enabled": false,
        "text": "[{name}] {title}"
      },
      "favicon": {
        "enabled": false,
        "text": ""
      }
    }
  ],
  "rules": [
    {
      "id": "sample-master-data",
      "name": "Master Data",
      "enabled": true,
      "conditions": [
        {
          "field": "company",
          "op": "contains",
          "value": "masterdata, master data, template"
        }
      ],
      "color": "#eaa300",
      "textColor": "auto",
      "styleId": "full",
      "favicon": {
        "text": "M"
      }
    },
    {
      "id": "sample-production",
      "name": "Production",
      "enabled": true,
      "conditions": [
        {
          "field": "environment",
          "op": "contains",
          "value": "production"
        }
      ],
      "color": "#107c10",
      "textColor": "auto",
      "styleId": "full",
      "favicon": {
        "text": "P"
      }
    },
    {
      "id": "sample-uat",
      "name": "UAT",
      "enabled": true,
      "conditions": [
        {
          "field": "environment",
          "op": "contains",
          "value": "uat, test, qa, sandbox"
        }
      ],
      "color": "#c4314b",
      "textColor": "auto",
      "styleId": "full",
      "favicon": {
        "text": "U"
      }
    },
    {
      "id": "sample-development",
      "name": "Development",
      "enabled": true,
      "conditions": [
        {
          "field": "environment",
          "op": "contains",
          "value": "dev"
        }
      ],
      "color": "#0f6cbd",
      "textColor": "auto",
      "styleId": "full",
      "favicon": {
        "text": "D"
      }
    }
  ],
  "webClient": {
    "maximize": {
      "enabled": true
    },
    "dropdown": {
      "width": 5,
      "height": 5
    },
    "resizePanes": {
      "enabled": true
    },
    "highlightRow": {
      "enabled": true
    },
    "stripeRows": {
      "enabled": false
    },
    "noAnimations": {
      "enabled": false
    },
    "hideNotifications": {
      "enabled": true
    },
    "copyValues": {
      "enabled": true
    },
    "weekNumbers": {
      "enabled": true
    },
    "shortcuts": {
      "enabled": true
    }
  }
}
